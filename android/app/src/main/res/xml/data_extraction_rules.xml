<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup policy. The hidden-notes key lives in
     flutter_secure_storage, wrapped by a device-bound Keystore key that is
     never backed up, so restoring these prefs elsewhere only yields an
     unusable key. Use the in-app "Hidden Notes Key" export instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
